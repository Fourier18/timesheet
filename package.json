{
  "name": "timesheet",
  "version": "1.0.0",
  "description": "Local clock-in/clock-out timesheet (Electron)",
  "main": "main.js",
  "author": "Joshua",
  "license": "MIT",
  "scripts": {
    "icon": "node scripts/gen-icon.js",
    "start": "electron .",
    "build": "npm run icon && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.joshua.timesheet",
    "productName": "Timesheet",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Timesheet",
      "menuCategory": false
    }
  }
}
